# 复制本文件为 .env（同目录），然后把下面替换成你的真实值
# 通用 LLM 配置——换平台（GLM/火山 ARK/DeepSeek 等 OpenAI 兼容）只改下面，不改代码
# 平台 baseURL 示例：GLM Coding plan → https://open.bigmodel.cn/api/coding/paas/v4 ；火山 ARK → https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-5.3
# key 创建地址：GLM → https://open.bigmodel.cn/usercenter/apikeys ；火山 ARK → 方舟控制台 API Key
LLM_API_KEY=在这里粘贴你的key
# 上下文预算（可选，默认 6000）
LLM_BUDGET_TOKENS=6000

# thinking 协议标识：模型怎么表达思考开关——换模型只改这一个值，不用改代码
#   openapi → 火山/GLM/DeepSeek 风格 {thinking:{type:enabled|disabled}}+reasoning_effort
#   bool    → 单布尔 thinking:true|false
#   none    → 不支持思考参数（不传，省得撞 400）
LLM_THINKING_STYLE=openapi

# embedding 端点/模型（可选，默认 GLM 按量端点；换平台改这里）
LLM_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_EMBED_MODEL=embedding-3
# embedding 的 key（可选——省略回落 LLM_API_KEY；embed 挂别的平台就填它的 key，如硅基流动免费 bge）
# LLM_EMBED_API_KEY=

# 记忆写入策略 A （系统提示词提示记录） | B（会话跑完时记录） | AB （系统提示词记录 & 会话跑完记录）
WRITE_STRATEGY=AB

# planner待处理步骤任务并行跑 1并行  0串行
PARALLEL=1

# 09 权限模式：default=写类问人（原状）| auto=confirm 档自动放行（run_shell 除外；deny/pre-hook/沙箱照跑）
PERMISSION_MODE=auto

# hook超时时间
HOOK_TIMEOUT_MS=30000

# 超时弃子时间
FANOUT_TIMEOUT_MS= 120000

# Langfuse 云观测（§4 双写对照；key 只在此处，源码/库永不出现真值）
# 注册 https://langfuse.com → 项目 → 设置 → API Keys 拿 public + secret；base URL 看你区域
#   EU 区 https://cloud.langfuse.com | US 区 https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-在这里粘贴
LANGFUSE_SECRET_KEY=sk-lf-在这里粘贴
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# §6 运行时成本护栏：整 run prompt+completion 合计硬顶，超顶 fail-closed 出诊断报告（默认 24000 ≈ 干净全链 12k 的 2 倍）
COST_CEILING_TOKENS=24000

# §7 大小模型路由的小档（可选——缺 LLM_LIGHT_MODEL = 不路由，浅窗口自动回落主模型）：
# 判断题/转写类浅窗口（审校①②/写手首稿）走便宜模型，重活（研究员/写手修订）走主模型
# GLM 示例：小档 glm-5.3-flash 走按量端点（输入 0.8 元/百万 token），key 缺省共用 LLM_API_KEY
# LLM_LIGHT_MODEL=glm-5.3-flash
# LLM_LIGHT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_LIGHT_API_KEY=

# §7 故障 failover 的备用档（可选）：主档或小档故障时切它续跑（quota 配额墙立即切、瞬态重试用尽后切）。
# 备用必须跨配额池——同端点同 key 的备用=假备用（主档挂它跟着挂），跨平台备用（如火山）要配自己的 BASE_URL + KEY；
# 三项全缺省回落小档配置——注意此时小档故障切备用=同模型同端点（自切无效，自动跳过不切）
# LLM_BACKUP_MODEL=glm-5.3-flash
# LLM_BACKUP_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_BACKUP_API_KEY=
# ===== 12-capstone daily-brief（毕业项目 §7）=====
# GitHub API 匿名限流 60 req/h（每天 4 发够用）；配 token 提到 5000/h
# github.com/settings/tokens → 经典 token 勾 public_repo 即可
# GITHUB_TOKEN=

# Server酱推送（sct.ftqq.com 微信扫码注册拿 SENDKEY，免费每天 5 条/人；缺省=通知 no-op 产线照常跑）
# 多人（家人共用产线各收各的）：每人各自注册、各自扫码，key 逗号分隔配 SCT_SENDKEYS
# SCT_SENDKEYS=key甲,key乙
# 兼容旧单数写法（等价数组一个成员，与复数可并存）：
# SCT_SENDKEY=

# 读报服务端口（server.ts 监听）
# BRIEF_PORT=8787

# 截图取字 · AI 识别引擎（视觉 LLM；不配则「AI 识别」按钮报错、本地引擎照常可用）
# 缺省沿用备用档端点/KEY，模型默认 glm-4.5v；三件都可单独覆盖
# LLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_VISION_MODEL=glm-4.5v
# LLM_VISION_API_KEY=

# 个人 Agent 工作台 · 数据根目录（会话/图片/以后记忆与 RAG 索引；缺省 personal-agent/data）
# 相对路径按启动时 cwd 解析；绝对路径也可
# PA_DATA_DIR=

# 单次发送的上下文预算（估算 token，默认 6000）：超了先摘要旧轮，失败/仍超再滑动窗口
# PA_CONTEXT_BUDGET=6000
