# 复制本文件为 .env（同目录），然后把下面替换成你的真实 key
# key 创建地址：https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=在这里粘贴你的key

# 记忆写入策略 A （系统提示词提示记录） | B（会话跑完时记录） | AB （系统提示词记录 & 会话跑完记录）
WRITE_STRATEGY=AB

# planner待处理步骤任务并行跑 1并行  0串行
PARALLEL=1

# 09 权限模式：default=写类问人（原状）| auto=confirm 档自动放行（run_shell 除外；deny/pre-hook/沙箱照跑）
PERMISSION_MODE=auto

# hook超时时间
HOOK_TIMEOUT_MS=30000

# 超时弃子时间
FANOUT_TIMEOUT_MS= 120000